# Server runtime only. Never use NEXT_PUBLIC_ for these values.
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional comparison provider; set MODEL_PROVIDER=openai to select it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Private demo access code, at least 16 characters; supplied by the operator.
RESEARCH_DEMO_TOKEN=
# Optional canonical app origin for reverse proxies, e.g. https://research.example.com
# Use only scheme + host + optional port; no trailing slash or path.
RESEARCH_APP_ORIGIN=
