# Server runtime only. Never use NEXT_PUBLIC_ for these values.
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional comparison provider; set MODEL_PROVIDER=openai to select it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Private demo access code, at least 16 characters; supplied by the operator.
RESEARCH_DEMO_TOKEN=
# Required independent session signing key; generate 32+ random bytes on the server.
# Rotation invalidates every browser session. Never paste this into chat or GitHub.
REVIEW_SESSION_SECRET=
# Optional canonical app origin for reverse proxies, e.g. https://research.example.com
# Use only scheme + host + optional port; no trailing slash or path.
RESEARCH_APP_ORIGIN=

# Question operation receipts must survive releases/restarts on the self-hosted Node server.
# Set an absolute, private, writable directory outside the checkout/.next, backed up by the operator.
# Multiple Node workers must share the same filesystem.
# Receipts contain research data and signed drafts: keep private. Provider keys are never written.
# Initialize once with scripts/research-operation-store.mjs init before production start.
# The sibling DIRECTORY.claims index must stay current; receipt restore never overwrites it.
# Both directories 0700, JSON files 0600, owned by the Node service UID, same local filesystem.
# Bounds: 1000 operations / 1 GiB reserved receipts; stop below 128 MiB or 1024 free inodes.
# Backup/recovery commands and limitations: docs/PR35_SESSION_RECOVERY_RC.md at repository root.
RESEARCH_RUN_DIRECTORY=
