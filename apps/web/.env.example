# Server runtime only. Never use NEXT_PUBLIC_ for these values.
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional comparison provider; set MODEL_PROVIDER=openai to select it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
# Private demo access code, at least 16 characters; supplied by the operator.
RESEARCH_DEMO_TOKEN=
# Optional competition mode. `open` removes the code form but still issues a
# signed anonymous session so paid APIs retain ownership and idempotency gates.
# Keep unset for code-gated review environments.
REVIEW_ACCESS_MODE=
# Required independent session signing key; generate 32+ random bytes on the server.
# Rotation invalidates every browser session. Never paste this into chat or GitHub.
REVIEW_SESSION_SECRET=
# Optional canonical app origin for reverse proxies, e.g. https://research.example.com
# Use only scheme + host + optional port; no trailing slash or path.
RESEARCH_APP_ORIGIN=

# Question operation receipts must survive releases/restarts on the self-hosted Node server.
# Set an absolute, private, writable directory outside the checkout/.next, backed up by the operator.
# Multiple Node workers must share the same filesystem.
# Receipts contain research data and signed drafts: keep private. Provider keys are never written.
# Initialize once with scripts/research-operation-store.mjs init before production start.
# The sibling DIRECTORY.claims index must stay current; receipt restore never overwrites it.
# Both directories 0700, JSON files 0600, owned by the Node service UID, same local filesystem.
# Bounds: 1000 operations / 1 GiB reserved receipts; stop below 128 MiB or 1024 free inodes.
# Backup/recovery commands and limitations: docs/PR35_SESSION_RECOVERY_RC.md at repository root.
RESEARCH_RUN_DIRECTORY=

# Production paid calls also require the sibling DIRECTORY.model-budget ledger.
# Initialize ONCE (same Node service UID) with:
# node --experimental-strip-types scripts/model-budget-store.mjs init /absolute/run-directory
# Read counters with the same command using inspect instead of init.
# Both question and memo use this ledger: lifetime 240 provider attempts,
# 24/visitor/hour, 30 global/minute, one in-flight request across Node processes.
# Input estimate is full UTF-8 wire bytes + 4096, at most 32768 per request;
# original output limits/timeout remain unchanged. Failure/unknown usage is not refunded.
# No automatic lifetime reset. Never delete/reinitialize/roll back the ledger to
# make quota available. Missing/corrupt/private-mode failures block paid calls.
# Keep this ledger across releases and back it up separately with current state.
# These bound request/token exposure; the provider's own monetary cap and billing
# controls remain external dependencies. No environment flag disables production protection.
