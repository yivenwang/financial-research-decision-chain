{
  "name": "financial-research-decision-chain-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-pdf-worker.mjs",
    "dev": "next dev --webpack",
    "prebuild": "node scripts/prepare-pdf-worker.mjs",
    "build": "next build --webpack",
    "build:site": "node scripts/prepare-pdf-worker.mjs && vinext build",
    "postbuild": "node scripts/release-preflight.mjs --record-build",
    "release:preflight": "node scripts/release-preflight.mjs",
    "start": "next start",
    "test:parser": "node --experimental-strip-types --test tests/parser-v04-regression.test.mjs",
    "test:parser-layout": "node --experimental-strip-types --test ../../tests/parser-layout-generalization.test.mjs ../../tests/parser-layout-ci-scope.test.mjs ../../tests/chain-v01.test.mjs",
    "test:integration": "node --experimental-strip-types --test tests/engine-integration.test.mjs",
    "test:transfer": "node --experimental-strip-types --test tests/transfer-probe.test.mjs",
    "test": "npm run test:parser && npm run test:parser-layout && npm run test:integration && npm run test:transfer && npm run test:memo && npm run test:question && npm run test:access && npm run test:rc",
    "test:access": "node --experimental-strip-types --test tests/reviewer-access.test.mjs tests/request-security.test.mjs tests/browser-capabilities.test.mjs tests/reviewer-audit.test.mjs tests/research-operation-security.test.mjs",
    "test:question": "node --experimental-strip-types --test tests/research-question.test.mjs tests/question-batch.test.mjs tests/question-reliability.test.mjs tests/question-live-v3.test.mjs tests/adversarial-review.test.mjs",
    "eval:review": "NODE_OPTIONS=--experimental-strip-types PROMPTFOO_DISABLE_TELEMETRY=1 npx --yes promptfoo@0.123.1 eval -c evals/reviewer-offline.yaml --no-cache --no-progress-bar",
    "test:question-browser": "node --experimental-strip-types --test tests/question-browser.test.mjs",
    "test:question-reliability-browser": "node --experimental-strip-types --test tests/question-reliability-browser.test.mjs",
    "test:memo": "node --experimental-strip-types --test tests/research-memo.test.mjs tests/memo-storage-concurrency.test.mjs tests/memo-batch.test.mjs tests/memo-revisions.test.mjs",
    "test:runtime": "node --test tests/runtime-smoke.test.mjs",
    "test:browser": "node --experimental-strip-types --test tests/browser-e2e.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern public/vendor",
    "test:rc": "node --experimental-strip-types --test tests/finance-rc.test.mjs tests/dashboard-rc.test.mjs tests/interaction-rc.test.mjs",
    "test:rc-browser": "node --experimental-strip-types --test tests/interaction-rc-browser.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "@typesafe-ai/sdk": "0.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
