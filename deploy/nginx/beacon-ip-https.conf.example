# Template only: not installed or nginx-tested on 192.144.168.226.
# Inspect existing sites first; place these zones in nginx's http context once.
limit_req_zone $binary_remote_addr zone=beacon_login:10m rate=5r/m;
limit_conn_zone $binary_remote_addr zone=beacon_connections:10m;

server {
    listen 80;
    server_name 192.144.168.226;
    # Must also exist in the initial HTTP vhost BEFORE certificate issuance.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / { return 308 https://192.144.168.226$request_uri; }
}

server {
    listen 443 ssl;
    server_name 192.144.168.226;
    ssl_certificate /etc/letsencrypt/live/192.144.168.226/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/192.144.168.226/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    client_body_timeout 10s;
    client_header_timeout 10s;
    limit_conn beacon_connections 20;

    location = /api/access {
        limit_req zone=beacon_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        # Overwrite client-supplied forwarding headers at this sole public proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_send_timeout 30s;
        proxy_read_timeout 190s;
    }
}
